{
  "id": "price-watch",
  "version": 1,
  "release": "1.0.0",
  "name": "price-watch",
  "description": "Offline synthetic example; no network or paid services.",
  "scene": {
    "id": "price-watch",
    "name": {
      "en": "price-watch",
      "zh": "price-watch"
    }
  },
  "objects": {
    "product_id": {
      "name": {
        "en": "Product",
        "zh": "商品"
      },
      "from": [
        {
          "url_param": "id"
        },
        {
          "column": [
            "product_id"
          ]
        },
        {
          "selection": "^(PR|JB)-[0-9]{4}$"
        }
      ]
    }
  },
  "tools": [
    {
      "id": "price-watch",
      "hosts": [
        "price-watch.example.test"
      ],
      "pages": [
        {
          "id": "detail",
          "paths": [
            "^/detail$"
          ],
          "columns": {
            "product_id": [
              "Product",
              "product_id"
            ],
            "price": [
              "Price",
              "price"
            ],
            "stock": [
              "Stock",
              "stock"
            ],
            "change": [
              "Price change",
              "change"
            ]
          },
          "flows": [
            "watch_price"
          ]
        }
      ]
    }
  ],
  "schemas": {
    "product.record": {
      "input": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "product_id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string",
                  "maxLength": 100
                },
                "price": {
                  "type": "number"
                },
                "stock": {
                  "type": "string",
                  "maxLength": 100
                },
                "change": {
                  "type": "number"
                }
              },
              "required": [
                "product_id",
                "price",
                "stock",
                "change"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "source": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "records",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "capabilities": {
    "product.record": [
      {
        "id": "price-watch-local",
        "type": "command",
        "argv": [
          "python3",
          "./record.py"
        ],
        "risk": "zero",
        "local_only": true,
        "read_only": false,
        "cost": "local",
        "batch_limit": 1
      }
    ]
  },
  "flows": {
    "watch_price": {
      "name": {
        "en": "Record visible price",
        "zh": "记录可见价格"
      },
      "object": "product_id",
      "judgment": false,
      "risk": "zero",
      "description": {
        "en": "Read the bundled synthetic visible page and write an isolated local list.",
        "zh": "读取随包合成可见页面，写入隔离的本地清单。"
      },
      "when": {
        "en": "On the synthetic detail page with an explicit ID.",
        "zh": "在合成详情页有明确编号时。"
      },
      "steps": [
        {
          "id": "record",
          "capability": "product.record",
          "risk": "zero",
          "input": {
            "product_id": "$input.object"
          }
        }
      ],
      "result": {
        "columns": [
          {
            "field": "product_id",
            "label": {
              "en": "Product",
              "zh": "商品"
            }
          },
          {
            "field": "price",
            "label": {
              "en": "Price",
              "zh": "价格"
            }
          },
          {
            "field": "stock",
            "label": {
              "en": "Stock",
              "zh": "库存"
            }
          },
          {
            "field": "change",
            "label": {
              "en": "Price change",
              "zh": "价格变化"
            }
          }
        ],
        "primary": "product_id"
      }
    }
  }
}
