{
  "id": "support-triage-example",
  "version": 1,
  "release": "1.0.0",
  "name": "工单材料核对示例",
  "description": "可运行的离线示例，只读取随包合成数据。",
  "experience": "当前场景为工单材料核对。先核对缺失材料，建议按收集材料、只读核实、人工确认的顺序排列。不要承诺已修改订单，不要建议重复完成的步骤。",
  "tools": [
    {
      "id": "support-triage-example",
      "name": {
        "zh": "合成工单台",
        "en": "Synthetic support desk"
      },
      "hosts": [
        "support.example.test"
      ],
      "pages": [
        {
          "id": "case",
          "paths": [
            "^/cases$"
          ],
          "flows": [
            "support_materials",
            "support_reply_draft"
          ],
          "columns": {
            "case_id": [
              "case_id"
            ],
            "customer": [
              "customer"
            ],
            "missing_materials": [
              "missing_materials"
            ],
            "status": [
              "status"
            ]
          }
        }
      ]
    }
  ],
  "schemas": {
    "case.inspect": {
      "input": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "case_id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "case_id": {
                  "type": "string",
                  "maxLength": 40
                },
                "customer": {
                  "type": "string",
                  "maxLength": 100
                },
                "missing_materials": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "maxItems": 20
                },
                "status": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              "required": [
                "case_id"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "source": {
            "type": "string",
            "maxLength": 500
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 50
          }
        },
        "required": [
          "records",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "capabilities": {
    "case.inspect": [
      {
        "id": "support-example-local",
        "type": "command",
        "argv": [
          "python3",
          "./inspect_case.py"
        ],
        "batch_limit": 1,
        "cost": "local",
        "risk": "zero",
        "read_only": true,
        "local_only": true
      }
    ]
  },
  "flows": {
    "support_materials": {
      "name": {
        "zh": "核对工单材料",
        "en": "Review case materials"
      },
      "object": "case_id",
      "judgment": false,
      "risk": "zero",
      "steps": [
        {
          "id": "read_case",
          "capability": "case.inspect",
          "risk": "zero",
          "input": {
            "case_id": "$input.object"
          }
        }
      ],
      "description": {
        "zh": "读取合成工单并核对缺失材料。",
        "en": "Read a synthetic case and review missing materials."
      },
      "when": {
        "zh": "在工单页有明确工单号，需要确认材料是否齐全时。",
        "en": "When an explicit case ID is present and materials need review."
      },
      "result": {
        "columns": [
          {
            "field": "case_id",
            "label": {
              "zh": "工单号",
              "en": "Case"
            }
          },
          {
            "field": "customer",
            "label": {
              "zh": "客户",
              "en": "Customer"
            }
          },
          {
            "field": "missing_materials",
            "label": {
              "zh": "缺失材料",
              "en": "Missing materials"
            }
          },
          {
            "field": "status",
            "label": {
              "zh": "状态",
              "en": "Status"
            }
          }
        ],
        "primary": "case_id"
      },
      "triggers": [
        {
          "page": {
            "tool": "support-triage-example",
            "page": "case"
          }
        },
        {
          "table_columns": {
            "all": [
              "Case",
              "Status"
            ]
          }
        },
        {
          "selection": {
            "object": "case_id"
          }
        }
      ],
      "next": [
        {
          "flow": "support_reply_draft",
          "when": {
            "field": "missing_materials",
            "records": "all",
            "empty": true
          }
        }
      ]
    },
    "support_reply_draft": {
      "name": {
        "en": "Review reply materials",
        "zh": "复核回复材料"
      },
      "object": "case_id",
      "judgment": false,
      "risk": "zero",
      "steps": [
        {
          "id": "read_case",
          "capability": "case.inspect",
          "risk": "zero",
          "input": {
            "case_id": "$input.object"
          }
        }
      ],
      "description": {
        "en": "Recheck synthetic materials before a human drafts a reply; sends nothing.",
        "zh": "人工起草回复前复核合成材料，不发送任何内容。"
      },
      "when": {
        "zh": "在工单页有明确工单号，需要确认材料是否齐全时。",
        "en": "When an explicit case ID is present and materials need review."
      },
      "result": {
        "columns": [
          {
            "field": "case_id",
            "label": {
              "zh": "工单号",
              "en": "Case"
            }
          },
          {
            "field": "customer",
            "label": {
              "zh": "客户",
              "en": "Customer"
            }
          },
          {
            "field": "missing_materials",
            "label": {
              "zh": "缺失材料",
              "en": "Missing materials"
            }
          },
          {
            "field": "status",
            "label": {
              "zh": "状态",
              "en": "Status"
            }
          }
        ],
        "primary": "case_id"
      },
      "triggers": []
    }
  },
  "scene": {
    "id": "support",
    "name": {
      "zh": "工单协作",
      "en": "Support"
    }
  },
  "objects": {
    "case_id": {
      "name": {
        "zh": "工单号",
        "en": "Case ID"
      },
      "from": [
        {
          "url_param": "q"
        },
        {
          "column": [
            "Case",
            "工单号"
          ]
        },
        {
          "selection": "^[A-Z]{2}-\\d{4,}$"
        }
      ]
    }
  }
}
