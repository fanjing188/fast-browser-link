{
  "manifest_version": 3,
  "incognito": "spanning",
  "name": "Fast-browser-link",
  "version": "2.4.0",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "scripting",
    "tabs",
    "tabGroups",
    "downloads",
    "storage",
    "alarms",
    "cookies",
    "notifications",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fast-browser-link",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": "",
  "short_name": "Fast-browser-link",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "description": "让 AI agent（Hermes、Codex、Claude Code 等）直接调用已连接的浏览器执行工作，连接授权后直接执行：页面操作、表单、上传下载、表格导出与实时协作。",
  "side_panel": {
    "default_path": "copilot-panel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "copilot-collector.mjs",
        "copilot-tables.mjs",
        "copilot-observation.mjs",
        "vendor/page-semantics.mjs",
        "vendor/redact.mjs",
        "copilot-selection.mjs",
        "copilot-i18n.mjs",
        "brand.mjs",
        "ui-design.mjs",
        "copilot-annotations.mjs"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
