{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assist package.json version 1",
  "description": "Host validation additionally checks schema byte/depth bounds, namespace and file containment, declared record fields, object and step references, and local transform options.",
  "type": "object",
  "required": [
    "id",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "release": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "name": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "objects": {
      "type": "object",
      "maxProperties": 30,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "not": {
          "enum": [
            "keyword",
            "domain",
            "url"
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "from": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "url_param": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "url_param"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 20,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    }
                  },
                  "required": [
                    "column"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "selection": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "selection"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "name",
          "from"
        ],
        "additionalProperties": false
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "input": {
            "$ref": "#/$defs/schema"
          },
          "output": {
            "$ref": "#/$defs/schema"
          }
        },
        "required": [
          "input",
          "output"
        ],
        "additionalProperties": false
      }
    },
    "flows": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "$ref": "#/$defs/localized"
              }
            ]
          },
          "description": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              {
                "$ref": "#/$defs/localized"
              }
            ]
          },
          "when": {
            "$ref": "#/$defs/localized"
          },
          "object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "decision_schema": {
            "$ref": "#/$defs/schema"
          },
          "result": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "$ref": "#/$defs/result"
              }
            ]
          },
          "judgment": {
            "type": "boolean"
          },
          "risk": {
            "enum": [
              "zero",
              "metered",
              "external"
            ]
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 41
                },
                "transform": {
                  "type": "string"
                },
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "options": {
                  "type": "object"
                },
                "risk": {
                  "enum": [
                    "zero",
                    "metered",
                    "external"
                  ]
                }
              },
              "required": [
                "id"
              ]
            }
          }
        },
        "required": [
          "name",
          "steps"
        ]
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object"
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "experience": {
      "type": "string",
      "maxLength": 800
    },
    "experience_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "fetchers": {
      "type": "object"
    },
    "pool": {
      "type": "object"
    },
    "rules": {
      "type": "object"
    },
    "prompts": {
      "type": "object"
    },
    "workflows": {
      "type": "object"
    },
    "capabilities": {
      "type": "object"
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "schema": {
      "type": "object",
      "properties": {
        "type": {
          "oneOf": [
            {
              "enum": [
                "object",
                "array",
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "object",
                  "array",
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "null"
                ]
              },
              "minItems": 1
            }
          ]
        },
        "properties": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "$ref": "#/$defs/schema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/$defs/schema"
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12000
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12000
        },
        "enum": {
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "label": {
                "$ref": "#/$defs/name"
              }
            },
            "required": [
              "field",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "primary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "columns",
        "primary"
      ],
      "additionalProperties": false
    },
    "name": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    }
  }
}
