{
  "manifest_version": 3,
  "incognito": "spanning",
  "name": "Fast-browser-link",
  "version": "2.1.0",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "scripting",
    "tabs",
    "tabGroups",
    "downloads",
    "storage",
    "alarms",
    "cookies",
    "notifications"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fast-browser-link",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": "",
  "short_name": "Fast-browser-link",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "description": "连接本机 AI Agent 与 Chrome/Edge，连接授权后直接执行普通及无痕任务，支持连续登录日志、表单、上传下载、用户接管和敏感字段保护。"
}
