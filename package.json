{
  "name": "fast-browser-link",
  "version": "2.3.0",
  "private": true,
  "description": "任何 Agent 均可通过 Skills、CLI 或 MCP 使用核心浏览器能力；Assist（协作）支持 Hermes 和 Codex。",
  "type": "module",
  "author": "FanJean",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanjing188/fast-browser-link.git"
  },
  "homepage": "https://github.com/fanjing188/fast-browser-link#readme",
  "bugs": {
    "url": "https://github.com/fanjing188/fast-browser-link/issues"
  },
  "keywords": [
    "hermes",
    "browser-automation",
    "chrome-extension",
    "native-messaging",
    "ai-agent",
    "edge-extension",
    "hermes-plugin",
    "local-browser",
    "target-recovery",
    "cookie-mirror",
    "python-workflows"
  ],
  "license": "MIT",
  "scripts": {
    "test": "python3 scripts/test-core.py",
    "check:js": "node scripts/check-runtime.mjs",
    "check:manifest": "node scripts/check-runtime.mjs --manifest",
    "check:docs": "node scripts/check-bridge-docs.mjs",
    "lint": "eslint .",
    "build": "node native-extension/build.mjs",
    "dev:sync": "node scripts/dev-sync-local.mjs",
    "dev:watch": "node scripts/dev-watch-desktop.mjs",
    "tasks:ack": "python3 scripts/tasks-ack.py",
    "package": "node scripts/package-executor.mjs",
    "verify": "python3 scripts/verify-v1.1-offline.py",
    "check:public": "bash scripts/check-public-release.sh",
    "version:set": "node scripts/version-set.mjs",
    "check:version": "node scripts/package-version.mjs",
    "package:agent": "python3 scripts/package-agent.py",
    "format": "prettier --write \"**/*.{js,mjs}\" && ruff format .",
    "format:check": "prettier --check \"**/*.{js,mjs}\" && ruff format --check ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tanstack/react-query": "5.101.2",
    "eslint": "^9",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^30.0.1",
    "linkedom": "0.18.12",
    "prettier": "3.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
