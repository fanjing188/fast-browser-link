    "required": [
      "verdict",
      "level",
      "process",
      "next"
    ],
    "additionalProperties": false
  },
  "display_fields": [
    "verdict",
    "level",
    "metrics",
    "missing",
    "process",
    "next",
    "domain",
    "top_pages"
  ],
  "toolsets": [
    "none"
  ],
  "cacheable": false,
  "max_turns": 1,
  "fetch": [
    {
      "script": "competitor_keywords",
      "params_schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "keywords": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "keyword": {
                  "type": "string",
                  "maxLength": 200
                },
                "vol": {
                  "type": "number"
                },
                "kd": {
                  "type": "number"
                },
                "cpc": {
                  "type": "number"
                },
                "url": {
                  "type": "string",
                  "maxLength": 2000
                },
                "position": {
                  "type": "number"
                },
                "source": {
                  "type": "string",
                  "maxLength": 500
                },
                "field_sources": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              },
              "required": [
                "keyword"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          },
          "source": {
            "type": "string",
            "maxLength": 500
          },
          "queries": {
            "type": "integer"
          },
          "pages": {
            "type": "array",
