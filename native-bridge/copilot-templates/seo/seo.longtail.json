        "type": "string",
        "maxLength": 30
      },
      "level": {
        "type": "string",
        "enum": [
          "go",
          "test",
          "skip",
          "info"
        ]
      },
      "metrics": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 30
            },
            "value": {
              "type": "string",
              "maxLength": 80
            }
