{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional local skill capability declaration",
  "type": "object",
  "required": [
    "version",
    "bindings"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "bindings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "capability",
          "binding"
        ],
        "additionalProperties": false,
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "cost": {
            "enum": [
              "zero",
              "free",
              "local",
              "unknown",
              "paid",
              "credits"
            ]
          },
          "binding": {
            "type": "object",
            "required": [
              "id",
              "type",
              "argv"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,80}$"
              },
              "type": {
                "const": "command"
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "priority": {
                "type": "integer"
              },
              "batch_limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "timeout": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600
              },
              "output": {
                "type": "object"
              },
              "stop_codes": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "stop_text": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "risk": {
                "enum": [
                  "zero",
                  "metered",
                  "external"
                ],
                "default": "metered"
              },
              "read_only": {
                "type": "boolean"
              },
              "local_only": {
                "type": "boolean"
              },
              "public": {
                "type": "boolean"
              },
              "requires_login": {
                "type": "boolean"
              },
              "external": {
                "type": "boolean"
              },
              "estimated_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
