{
  "id": "seo.longtail",
  "name": "拆长尾",
  "prompt": "只填判断结构；不输出量、KD、CPC或排名数字。verdict≤30字，写判断，不写查询过程。只对给定候选做去重、意图分组和推荐标记；groups.keywords只引用原候选，不扩造词。",
  "params_schema": {
    "type": "object",
    "properties": {
      "keyword": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "market": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "required": [
      "keyword"
    ],
    "additionalProperties": false
  },
