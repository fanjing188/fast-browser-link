{
  "id": "example-seo-tool",
  "version": 1,
  "fetchers": {
    "domain_rating": [
      "python3",
      "./metrics.py"
    ]
  },
  "rules": {
    "description": {
      "en": "Prefer evidence of a clear user task. Missing data does not imply low competition.",
      "zh": "优先验证明确的用户任务；缺数据不代表竞争低。"
    }
  },
  "tools": [
    {
      "id": "example-seo-tool",
      "hosts": [
        "seo.example.test"
      ],
      "name": {
        "en": "Example SEO tool",
        "zh": "示例数据工具"
      },
      "links": {
        "keyword": "https://seo.example.test/keywords?q={keyword}"
      },
      "pages": [
        {
          "id": "keywords",
          "paths": [
            "^/keywords$"
          ],
          "object_param": "q",
          "columns": {
            "keyword": [
              "Keyword"
            ],
            "vol": [
              "Volume"
            ],
            "kd": [
              "KD"
            ],
            "url": [
              "URL"
            ]
          },
          "actions": [
            "keyword.metrics"
          ],
          "flows": [
            "leaders",
            "intent_split",
            "pool_links"
          ]
        }
      ]
    }
  ],
  "files": [
    "metrics.py",
    "example_adapter.py"
  ],
  "capabilities": {
    "keyword.metrics": [
      {
        "id": "example-metrics",
        "type": "command",
        "argv": [
          "python3",
          "./example_adapter.py"
        ],
        "priority": 10,
        "batch_limit": 100,
        "exact": false,
        "fields": [
          "keyword"
        ],
        "cost": "unconfigured example; never fabricates metrics"
      }
    ]
  }
}
