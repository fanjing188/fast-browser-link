{
  "manifest_version": 3,
  "incognito": "spanning",
  "name": "Fast-browser-link",
  "version": "2.5.1",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "scripting",
    "tabs",
    "tabGroups",
    "downloads",
    "storage",
    "alarms",
    "cookies",
    "notifications"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fast-browser-link",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": "",
  "short_name": "Fast-browser-link",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "description": "让 AI agent 直接调用已连接的浏览器执行页面操作、表单填写、上传下载和数据读取；任务、授权与清理由 Fast-browser-link 管理。",
  "web_accessible_resources": [
    {
      "resources": [
        "product-browser-data.mjs",
        "product-observation.mjs",
        "product-selection.mjs",
        "product-table-confirm.mjs",
        "product-tables.mjs",
        "product-tool-reports.mjs",
        "vendor/page-semantics.mjs",
        "vendor/redact.mjs"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
