{
  "id": "seo.serp_breakdown",
  "name": "拆解搜索结果",
  "prompt": "优先使用 API 或批量脚本，必要时才浏览器读页。拆解当前搜索结果：排名站、页面类型、小站列表及结构性缺口；在 details 保留证据。",
  "params_schema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "required": [
      "url"
    ],
    "additionalProperties": false
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "keywords": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "keyword": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "market": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "lang": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "vol": {
              "type": "number"
            },
            "kd": {
              "type": "number"
            }
          },
          "required": [
            "keyword"
          ],
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "details": {
        "type": "string",
        "maxLength": 12000
      },
      "usage_tokens": {
        "type": "integer"
      }
    },
    "required": [
      "summary"
    ],
    "additionalProperties": false
  },
  "display_fields": [
    "summary",
    "keywords",
    "details"
  ],
  "toolsets": [
    "fast-browser-link",
    "web",
    "terminal",
    "file"
  ],
  "cacheable": false,
  "max_turns": 30
}
