          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "maxLength": 80
            },
            "reason": {
              "type": "string",
              "maxLength": 300
            }
          },
          "required": [
            "field",
            "reason"
          ],
          "additionalProperties": false
        },
        "maxItems": 20
      },
      "process": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 600
        },
        "maxItems": 30
      },
      "next": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "seo.keyword_check",
                "seo.longtail",
                "seo.competitor_keywords",
                "seo.serp_breakdown",
                "seo.save_pool",
                "seo.trends",
                "seo.ranking_sites",
                "seo.domain_rating",
                "seo.top_pages",
                "browser.open",
                "general.task"
